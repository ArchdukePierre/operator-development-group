<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HostPin.Mod</AssemblyName>
    <RootNamespace>HostPin</RootNamespace>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net6.0\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(OperatorDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

</Project>
