<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Diagnostics.Mod</AssemblyName>
    <RootNamespace>ODGDiag</RootNamespace>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(OperatorDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

</Project>
