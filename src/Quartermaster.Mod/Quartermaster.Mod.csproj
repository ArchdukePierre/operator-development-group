<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Quartermaster.Mod</AssemblyName>
    <RootNamespace>Quartermaster</RootNamespace>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net6.0\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\_shared\OdgPanel.cs" Link="OdgPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(OperatorDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(OperatorDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OdgPublic)' == 'true'">
    <DefineConstants>$(DefineConstants);ODG_PUBLIC</DefineConstants>
  </PropertyGroup>

</Project>
